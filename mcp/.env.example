# Copy to .env for local runs, or paste these into your host's env var UI.

# Same Postgres row auth/ writes to.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Same values as auth/'s. Do NOT set a static CC_ACCESS_TOKEN here — the
# database row is the source of truth.
CC_CLIENT_ID=
CC_CLIENT_SECRET=
# Optional. Defaults to https://api.cc.email/v3.
# CONSTANT_CONTACT_BASE_URL=

# Required. A random string, at least 24 chars. Generate with:
#   openssl rand -hex 24
# This becomes part of the MCP endpoint URL (/mcp/<secret>) — treat it like a
# password. Rotating this value immediately invalidates the old URL.
MCP_SHARED_SECRET=

# Used as defaults for the cc_create_campaign tool and as the CAN-SPAM
# footer address for any campaign it creates (same fields as composer/'s).
CC_FROM_NAME=
CC_FROM_EMAIL=
CC_REPLY_TO=
CC_ADDR_LINE1=
CC_ADDR_CITY=
CC_ADDR_STATE=
CC_ADDR_POSTAL=
CC_ADDR_COUNTRY=
CC_ADDR_ORG=

# Optional. Railway sets PORT automatically; only needed for local runs.
# PORT=3000
