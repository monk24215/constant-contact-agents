# Copy to .env for local runs, or paste these into your host's env var UI.

# Same Postgres row auth/ writes to — point both services at the same DB.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Same values as auth/'s.
CC_CLIENT_ID=
CC_CLIENT_SECRET=
# Optional. Defaults to https://api.cc.email/v3.
# CONSTANT_CONTACT_BASE_URL=

# Notion integration token and the content-calendar database id.
# https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DB_ID=

# Must be a sender email VERIFIED in your Constant Contact account, or CC
# will reject every draft.
CC_FROM_EMAIL=
# Optional — defaults to BRAND_NAME, then "Newsletter".
CC_FROM_NAME=
# Optional — defaults to CC_FROM_EMAIL.
CC_REPLY_TO=
# Optional, used as a fallback for CC_FROM_NAME and CC_ADDR_ORG.
BRAND_NAME=

# CAN-SPAM requires a physical mailing address in every campaign footer.
CC_ADDR_LINE1=
CC_ADDR_CITY=
CC_ADDR_STATE=
CC_ADDR_POSTAL=
# Optional — defaults to US.
CC_ADDR_COUNTRY=
# Optional — falls back to BRAND_NAME if unset.
CC_ADDR_ORG=

# How often (minutes) the composer polls Notion for new draft-ready rows.
# Optional — defaults to 15.
# POLL_MINUTES=15

# Optional but recommended. If set, "/" and "/run" require a matching
# ?key=... query param (404 otherwise) — without it, anyone who finds this
# service's URL can trigger a compose pass on demand via /run. Generate with:
#   openssl rand -hex 24
# COMPOSER_SHARED_SECRET=

# Optional. Railway sets PORT automatically; only needed for local runs.
# PORT=3000
