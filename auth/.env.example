# Copy to .env for local runs, or paste these into your host's env var UI.

# Postgres connection string holding the shared oauth_tokens table.
# On Railway, reference the Postgres service directly:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# From your Constant Contact developer app (https://developer.constantcontact.com/).
CC_CLIENT_ID=
CC_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your Constant Contact app,
# and point at THIS service's /callback route, e.g.:
#   https://<this-service>.up.railway.app/callback
CC_REDIRECT_URI=

# Optional. Defaults to https://api.cc.email/v3 — only change if CC gives you
# a different base URL for your account/region.
# CONSTANT_CONTACT_BASE_URL=

# Optional. Railway sets PORT automatically; only needed for local runs.
# PORT=3000
